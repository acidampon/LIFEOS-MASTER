{
  "name": "lifeos-master",
  "version": "1.5.2",
  "private": true,
  "description": "LIFEOS Android packaging project",
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-release.mjs",
    "android:prepare": "npm run build && npx cap sync android",
    "android:debug": "npm run verify && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "7.4.3",
    "@capacitor/android": "7.4.3",
    "@capacitor/local-notifications": "7.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3"
  }
}